{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Isle",
  "mainBinaryName": "isle",
  "identifier": "io.github.zickrian.isle",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "zickrian",
    "homepage": "https://github.com/zickrian/isle",
    "shortDescription": "A notch-style island at the top of the screen",
    "copyright": "© 2026 zickrian, GPL-3.0-or-later",
    "license": "GPL-3.0-or-later",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}